#!/usr/bin/env bash
# QQ 回复结算：把 QQ 回来的私聊/群消息写进投递台账（channel=qq）。契约见 INTERFACE.md §11.7d。
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$here/../src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -c 'import sys; from infohub.qq_replies import main; sys.exit(main())' "$@"
